{
  "name": "@hmm-chat/desktop",
  "version": "0.1.13",
  "private": true,
  "description": "Secure Electron desktop client for Hype Comms",
  "author": {
    "name": "Hypothetical Money Machine",
    "email": "callmemorgan@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "homepage": "https://github.com/hype-comms/hmm-chat",
  "desktopName": "com.hypotheticalmoneymachine.hmmchat.desktop",
  "main": "./dist/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/hype-comms/hmm-chat.git"
  },
  "scripts": {
    "prebuild": "npm run build --workspace @hmm-chat/contracts",
    "predev": "npm run build --workspace @hmm-chat/contracts && install-electron --no",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pretest": "npm run build --workspace @hmm-chat/contracts",
    "pretypecheck": "npm run build --workspace @hmm-chat/contracts",
    "typecheck": "tsc --build --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:win": "npm run build && electron-builder --win --x64 --arm64 --publish never",
    "package:win:arm64": "npm run build && electron-builder --win nsis:arm64 --publish never",
    "package:linux": "npm run build && electron-builder --linux --x64 --arm64 --publish never",
    "package:linux:arm64": "npm run build && electron-builder --linux AppImage:arm64 deb:arm64 --publish never",
    "package:linux:appimage": "npm run build && electron-builder --linux AppImage --x64 --arm64 --publish never",
    "package:linux:appimage:arm64": "npm run build && electron-builder --linux AppImage:arm64 --publish never"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "6.0.4",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "^20.11.1",
    "typescript": "^6.0.3",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@hmm-chat/contracts": "*",
    "dexie": "4.4.4",
    "electron-updater": "6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.hypotheticalmoneymachine.hmmchat",
    "productName": "Hype Comms",
    "executableName": "hype-comms",
    "artifactName": "hype-comms-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.hypemm.com/desktop"
      }
    ],
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Hype Comms authentication callback",
        "schemes": [
          "hmm-chat"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "buildUniversalInstaller": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "category": "Network;InstantMessaging",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}
