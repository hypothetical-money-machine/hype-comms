{
  "name": "@hype-comms/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run build --workspace @hype-comms/contracts",
    "build": "tsc -p tsconfig.json && node ./scripts/copy-migrations.mjs",
    "predev": "npm run build --workspace @hype-comms/contracts",
    "dev": "tsx watch src/main.ts",
    "seed:demo": "node --env-file-if-exists=../../.env.local ../../scripts/demo.mjs --seed-only",
    "invite": "tsx src/modules/identity/invite-cli.ts",
    "invite:dist": "node dist/modules/identity/invite-cli.js",
    "authkit:revoke-all": "tsx src/modules/identity/authkit-revoke-all-cli.ts",
    "authkit:revoke-all:dist": "node dist/modules/identity/authkit-revoke-all-cli.js",
    "bot": "tsx src/modules/bots/cli.ts",
    "bot:dist": "node dist/modules/bots/cli.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:dist": "node dist/db/migrate.js",
    "start": "node dist/main.js",
    "pretest": "npm run build --workspace @hype-comms/contracts",
    "test": "vitest run",
    "pretypecheck": "npm run build --workspace @hype-comms/contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/static": "10.1.2",
    "@fastify/websocket": "11.3.0",
    "@hype-comms/contracts": "*",
    "@workos-inc/node": "10.9.0",
    "fastify": "5.11.0",
    "jose": "6.2.8",
    "nodemailer": "^9.0.3",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.20.4",
    "@types/ws": "^8.18.0",
    "@workos/emulate": "0.7.0",
    "tsx": "4.23.8",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "ws": "^8.18.0"
  }
}
