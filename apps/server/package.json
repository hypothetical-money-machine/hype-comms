{
  "name": "@hmm-chat/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run build --workspace @hmm-chat/contracts",
    "build": "tsc -p tsconfig.json && node ./scripts/copy-migrations.mjs",
    "predev": "npm run build --workspace @hmm-chat/contracts",
    "dev": "tsx watch src/main.ts",
    "seed:demo": "node --env-file-if-exists=../../.env.local ../../scripts/demo.mjs --seed-only",
    "invite": "tsx src/modules/identity/invite-cli.ts",
    "invite:dist": "node dist/modules/identity/invite-cli.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:dist": "node dist/db/migrate.js",
    "start": "node dist/main.js",
    "pretest": "npm run build --workspace @hmm-chat/contracts",
    "test": "vitest run",
    "pretypecheck": "npm run build --workspace @hmm-chat/contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/static": "10.1.2",
    "@fastify/websocket": "11.3.0",
    "@hmm-chat/contracts": "*",
    "fastify": "5.10.0",
    "nodemailer": "^9.0.3",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.20.0",
    "@types/ws": "^8.18.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "ws": "^8.18.0"
  }
}
