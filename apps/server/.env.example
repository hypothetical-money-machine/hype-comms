NODE_ENV=development
HYPE_COMMS_HOST=127.0.0.1
HYPE_COMMS_PORT=3000
HYPE_COMMS_LOG_LEVEL=info
HYPE_COMMS_SHUTDOWN_TIMEOUT_MS=10000
HYPE_COMMS_ALLOWED_ORIGINS=http://127.0.0.1:5173
HYPE_COMMS_PUBLIC_API_URL=http://127.0.0.1:3000
# Direct development requests need no proxy trust. If a local reverse proxy is used, name only its
# exact IP address or CIDR; never use a blanket value or a hop count.
# HYPE_COMMS_TRUSTED_PROXIES=127.0.0.1
# Enable only after all server and realtime workers run announcement-compatible code.
HYPE_COMMS_ANNOUNCEMENT_CHANNELS_ENABLED=false
# Enable only after all server and realtime workers enforce humans-only channel access.
HYPE_COMMS_HUMANS_ONLY_CHANNELS_ENABLED=false
# Enable only after all server and realtime workers understand the reserved hype/ channel
# namespace. Seeding built-in channels is a one-way cutover per workspace.
HYPE_COMMS_SYSTEM_CHANNELS_ENABLED=false

# Optional WorkOS AuthKit. Configure all values together; use the exact loopback callback URI
# registered for this WorkOS Application. Production additionally requires WORKOS_WEBHOOK_SECRET.
# WORKOS_API_KEY=sk_test_replace-me
# WORKOS_CLIENT_ID=client_replace-me
# WORKOS_REDIRECT_URI=http://127.0.0.1:3000/v1/auth/workos/callback
# WORKOS_JWT_ISSUER=https://api.workos.com/
# HYPE_COMMS_AUTH_ENCRYPTION_KEY=replace-with-43-character-unpadded-base64url
# WORKOS_WEBHOOK_SECRET=replace-me
# Provider cleanup and a configured webhook remain active while this rollout gate is false.
HYPE_COMMS_AUTHKIT_ADMISSION_ENABLED=false

# PostgreSQL is required for production identity, conversations, events, and idempotency.
HYPE_COMMS_DATABASE_URL=postgres://hype_comms:password@127.0.0.1:5432/hype_comms
# HYPE_COMMS_DATABASE_POOL_SIZE=10
# HYPE_COMMS_SMTP_URL=smtp://127.0.0.1:1025
# HYPE_COMMS_EMAIL_FROM=Hype Comms <chat@example.com>
# HYPE_COMMS_OWNER_EMAIL=owner@example.com
HYPE_COMMS_WORKSPACE_NAME=Hype Comms
HYPE_COMMS_WORKSPACE_SLUG=hype-comms

# Optional directory of static files to serve at the web root.
# HYPE_COMMS_WEB_ROOT=
