NODE_ENV=development
HMM_HOST=127.0.0.1
HMM_PORT=3000
HMM_LOG_LEVEL=info
HMM_SHUTDOWN_TIMEOUT_MS=10000
HMM_ALLOWED_ORIGINS=http://127.0.0.1:5173
HMM_PUBLIC_API_URL=http://127.0.0.1:3000

# Access-code chat. Disabled by default; the access code is required when enabled.
HMM_CHAT_ENABLED=false
# HMM_CHAT_ACCESS_CODE=
HMM_CHAT_DATA_PATH=/data/hmm-chat.sqlite

# Optional Postgres-backed identity and email delivery.
# HMM_DATABASE_URL=postgres://hmm:password@127.0.0.1:5432/hmm_chat
# HMM_DATABASE_POOL_SIZE=10
# HMM_SMTP_URL=smtp://127.0.0.1:1025
# HMM_EMAIL_FROM=HMM Chat <chat@example.com>
# HMM_OWNER_EMAIL=owner@example.com
HMM_WORKSPACE_NAME=HMM Chat
HMM_WORKSPACE_SLUG=hmm-chat

# Optional directory of static files to serve at the web root.
# HMM_WEB_ROOT=
