# Copy to .env before running `docker compose up --build -d`.
# .env is git-ignored. Never commit a real access code.

# Shared access code for the deployment. Minimum 16 characters.
# Generate one with: openssl rand -base64 24
HMM_CHAT_ACCESS_CODE=

# Public URL users reach through the tunnel. Must be HTTPS when NODE_ENV=production.
# This also decides whether session cookies carry the Secure attribute.
HMM_PUBLIC_API_URL=https://chat.hypemm.com

# Comma-separated exact origins allowed to call the API and open websockets.
HMM_ALLOWED_ORIGINS=https://chat.hypemm.com

# Identity storage (M1, still being built). Leave both unset to run chat alone; the server
# registers identity features only when HMM_DATABASE_URL is set, and Postgres is behind the
# "identity" compose profile so a plain `docker compose up` never starts it.
# HMM_POSTGRES_PASSWORD=
# HMM_DATABASE_URL=postgres://hmm:<password>@postgres:5432/hmm_chat

# Host port the container publishes on 127.0.0.1.
HMM_BIND_PORT=3000

HMM_LOG_LEVEL=info

# Set to "development" only for local testing without TLS.
# HMM_NODE_ENV=development
