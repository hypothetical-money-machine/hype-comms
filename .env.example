# Copy to .env before running `docker compose up --build -d`.
# .env is git-ignored. Never commit real database, mail, or identity credentials.

# Generate with: openssl rand -base64 32
HMM_POSTGRES_PASSWORD=
HMM_DATABASE_URL=postgres://hmm:replace-me@postgres:5432/hmm_chat

# Public URL users reach through the tunnel. Must be HTTPS when NODE_ENV=production.
# This also decides whether session cookies carry the Secure attribute.
HMM_PUBLIC_API_URL=https://chat-api.example.invalid

# Comma-separated exact origins allowed to call the API and open websockets. These are the
# CLIENT's origins, not the API hostname: the desktop renderer sends app://bundle when
# packaged and http://127.0.0.1:5173 in development. The websocket route rejects any Origin
# that is not listed here.
HMM_ALLOWED_ORIGINS=app://bundle,http://127.0.0.1:5173

# Comma-separated reverse-proxy IP addresses/CIDRs allowed to supply X-Forwarded-For. The Compose
# default covers Docker's 172.16.0.0/12 private range; narrow or override it for your proxy network.
# Enabled production AuthKit admission refuses to start without an explicit trust boundary.
HMM_TRUSTED_PROXIES=172.16.0.0/12

# Rollout gate. Enable only after every server and realtime worker runs announcement-compatible
# code; the desktop creation UI remains hidden while this is false.
HMM_ANNOUNCEMENT_CHANNELS_ENABLED=false

# Who the first workspace owner is. Seeded once, on first boot.
HMM_OWNER_EMAIL=
# How sign-in links reach people. "manual" means an administrator issues them with
# `npm run invite:dist` and sends them privately, so no email provider is needed yet.
# Set HMM_SMTP_URL and HMM_EMAIL_FROM instead to deliver by email.
HMM_EMAIL_DELIVERY=manual

# Optional WorkOS AuthKit sign-in. Configure all four core values together. The redirect URI must
# be this server's exact public callback URL, and the encryption key must decode to 32 bytes.
# Generate the key with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# WORKOS_API_KEY=sk_live_replace-me
# WORKOS_CLIENT_ID=client_replace-me
# WORKOS_REDIRECT_URI=https://chat-api.example.invalid/v1/auth/workos/callback
# WORKOS_JWT_ISSUER=https://api.workos.com/
# HMM_AUTH_ENCRYPTION_KEY=
# WORKOS_WEBHOOK_SECRET=replace-me
# Keep admission fail-closed while staging the server, webhook, and proxy configuration. Flip this
# only after every serving instance runs the AuthKit-capable release.
HMM_AUTHKIT_ADMISSION_ENABLED=false

# Leave false for the first server rollout. Set true only after the prior server image is no
# longer a supported rollback target; that release cannot parse persisted agent identities.
HMM_AGENT_PROVISIONING_ENABLED=false

# Host port the container publishes on 127.0.0.1.
HMM_BIND_PORT=3000
HMM_POSTGRES_BIND_PORT=5432
HMM_DEMO_POSTGRES_BIND_PORT=54330

HMM_LOG_LEVEL=info
# Optional private Prometheus endpoint. Use a secret with at least 32 characters in deployment.
# HMM_METRICS_TOKEN=

# Set to "development" only for local testing without TLS.
# HMM_NODE_ENV=development
