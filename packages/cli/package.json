{
  "name": "@hype-comms/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Machine-readable command-line client for Hype Comms.",
  "type": "module",
  "bin": {
    "hype-comms-cli": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "npm run build --workspace @hype-comms/contracts",
    "build": "tsc -p tsconfig.json --noEmit && node build.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build --workspace @hype-comms/contracts",
    "test": "vitest run",
    "pretypecheck": "npm run build --workspace @hype-comms/contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hype-comms/contracts": "*",
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
