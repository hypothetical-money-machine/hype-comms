{
  "name": "hmm-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop-first, realtime team chat for Hypothetical Money Machine.",
  "license": "UNLICENSED",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.x",
    "npm": ">=11.16 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "check:fast": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "demo": "node --env-file-if-exists=.env.local scripts/demo.mjs",
    "demo:reset": "node --env-file-if-exists=.env.local scripts/demo-reset.mjs",
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "dev:join": "node --env-file-if-exists=.env.local scripts/dev-join.mjs",
    "dev:desktop": "node scripts/check-renderer-port.mjs && npm run dev --workspace @hmm-chat/desktop",
    "dev:server": "npm run dev --workspace @hmm-chat/server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "package:desktop": "npm run package --workspace @hmm-chat/desktop",
    "package:desktop:appimage": "npm run package:linux:appimage --workspace @hmm-chat/desktop",
    "seed:demo": "node --env-file-if-exists=.env.local scripts/demo.mjs --seed-only",
    "start:server": "npm run start --workspace @hmm-chat/server",
    "test": "npm run test:scripts && npm run test --workspaces --if-present",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:db": "scripts/test-database.sh",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:desktop-package": "node scripts/verify-desktop-package.mjs",
    "verify:desktop-package:macos-release": "node scripts/verify-macos-release.mjs"
  },
  "devDependencies": {
    "@electron/asar": "4.2.1",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.4",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
